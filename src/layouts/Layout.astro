---
// src/layouts/Layout.astro
interface Props {
    title: string;
    description?: string;
}

const { 
    title, 
    description = "Associació de Docents Ocupacionals de Catalunya. Defensem els drets laborals dels formadors de la FP i llitem contra el fals autònom." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ca">
<head>
    <script is:inline>
       if (window.location.hash && window.location.hash.includes('invite_token')) {
       window.location.href = `/admin/${window.location.hash}`;
    }
    </script>
    <meta charset="UTF-8">
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content="ADOCAT, docents ocupacionals, FP Catalunya, fals autònom, SOC, cursos CP, drets laborals formació">
    <meta name="robots" content="index, follow">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="/img/logo-full-adocat.png">
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .netlify-identity-badge {
            display: none !important;
        }
        div[id*="netlify"] {
            display: none !important;
        }
    </style>
    <script src="https://unpkg.com/netlify-identity-widget@1.9.2/dist/netlify-identity-widget.js"></script>
</head>

<body class="bg-brand-bg text-brand-dark min-h-screen flex flex-col font-sans antialiased">

    <!-- 🌐 NAVIGATION HEADER -->
    <header class="w-full bg-[#111111] text-white px-8 md:px-8 py-0 sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center">
               <img src="/2.png" alt="Logotip ADOCAT" class="h-20 w-auto object-contain" />    
                <span class="text-2xl font-black tracking-wider text-white -ml-8">ADOCAT</span>
            </div>
            
            <!-- 🖥️ DESKTOP NAV -->
            <nav class="hidden lg:flex items-center gap-6 text-[14px] md:text-[18px] font-bold uppercase tracking-wider text-gray-300">
                <a href="/" class="text-white hover:text-brand-green transition-colors">INICI</a>
                <a href="/diagnostic" class="text-brand-green font-extrabold border-b-2 border-brand-green pb-1">DIAGNÒSTIC</a>
                <a href="/noticies" class="hover:text-white transition-colors">NOTÍCIES</a>
                <a href="/denuncies" class="hover:text-white transition-colors text-amber-500">⚠️ DENÚNCIES</a>
                <a href="/compte" class="hover:text-white transition-colors">EL MEU COMPTE</a>
                <a href="/diagnostic?openAdmin=true" id="open-admin-nav-btn" class="text-gray-400 hover:text-white transition-colors text-xs border border-gray-700 px-2 py-1 rounded-sm flex items-center gap-1">ADMIN ⚙️</a>
            </nav>


            <div class="flex items-center gap-4">
                <!-- 📱 HAMBURGER BUTTON -->
                <button id="menu-toggle" class="lg:hidden text-white text-2xl focus:outline-none cursor-pointer p-1">
                    ☰
                </button>
            </div>
        </div>

        <!-- 📱 MOBILE NAV -->
        <nav id="mobile-menu" class="hidden lg:hidden gap-4 pt-4 pb-2 text-sm font-bold uppercase tracking-wider text-gray-300 border-t border-gray-800 mt-3 space-y-3">
            <a href="/" class="block">INICI</a>
            <a href="/diagnostic" class="block text-brand-green font-extrabold">DIAGNÒSTIC</a>
            <a href="/noticies" class="block">NOTÍCIES</a>
            <a href="/denuncies" class="block text-amber-500">⚠️ DENÚNCIES I AJUDA</a>
            <a href="/compte" class="block">EL MEU COMPTE</a>
            <a href="/diagnostic?openAdmin=true" id="open-admin-mob-btn" class="block text-gray-400 text-xs pt-2 border-t border-gray-800">ACCÉS ADMINISTRADOR ⚙️</a>
        </nav>

    </header>

    <main class="grow">
         <slot />
    </main>

    <!-- 📋 КОНТРАСТНЫЙ МНОГОКОЛОНОЧНЫЙ ФУТЕР -->
<footer class="w-full bg-[#111827] text-gray-100 text-sm py-16 border-t border-gray-800 mt-auto">
  <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-12 gap-10">
    
    <!-- Колонка 1: Логотип и Описание -->
    <div class="md:col-span-4 space-y-4 text-left">
      <h3 class="font-sans font-black text-white uppercase tracking-wider text-lg">ADOCAT</h3>
      <p class="text-gray-300 text-xs md:text-sm leading-relaxed font-medium">
        Associació de Docents Ocupacionals de Catalunya. Unim esforços i protegim els drets laborals dels formadors de la FP.
      </p>
      <div class="flex gap-4 pt-2 text-xs font-black uppercase tracking-wider">
        <a href="https://www.linkedin.com/company/adocat/?originalSubdomain=es" target="_blank" class="text-gray-300 hover:text-white transition-colors underline decoration-brand-green underline-offset-4">LinkedIn</a>
        <span class="text-gray-600">|</span>
        <a href="https://t.me/+4ahcQVP9jfoxOTdk" target="_blank" class="text-emerald-400 hover:text-emerald-300 transition-colors underline underline-offset-4">Telegram</a>
      </div>
    </div>

    <!-- Колонка 2: Навигация -->
    <div class="md:col-span-3 space-y-4 text-left">
      <h4 class="text-xs font-black uppercase text-gray-400 tracking-widest border-b border-gray-800 pb-2">Navegació</h4>
      <ul class="space-y-2.5 text-xs md:text-sm font-bold">
        <li><a href="/" class="text-gray-200 hover:text-white transition-colors">Inici</a></li>
        <li><a href="/diagnostic" class="text-gray-200 hover:text-white transition-colors">Diagnòstic</a></li>
        <li><a href="/noticies" class="text-gray-200 hover:text-white transition-colors">Notícies</a></li>
        <li><a href="/compte" class="text-gray-200 hover:text-white transition-colors">El meu Compte</a></li>
      </ul>
    </div>
    <!-- Колонка 3: Официальные контакты (Повышенный контраст) -->
    <div class="md:col-span-3 space-y-4 text-left">
      <h4 class="text-xs font-black uppercase text-gray-400 tracking-widest border-b border-gray-800 pb-2">Contacte Oficial</h4>
      <ul class="space-y-2.5 text-xs md:text-sm font-bold text-gray-200">
        <li class="flex flex-col">
          <span class="text-[10px] text-gray-400 font-black uppercase tracking-wider">Correu electrònic</span>
          <a href="mailto:info@adocat.es" class="text-white hover:text-emerald-400 transition-colors mt-0.5 text-sm md:text-base">info@adocat.es</a>
        </li>
        <li class="flex flex-col">
          <span class="text-[10px] text-gray-400 font-black uppercase tracking-wider">Telèfon de suport</span>
          <a href="tel:+34614696489" class="text-white hover:text-emerald-400 transition-colors mt-0.5 text-sm md:text-base">614 696 489</a>
        </li>
        <li class="text-[11px] text-gray-400 pt-1 font-semibold">
          Àmbit d'actuació: Generalitat de Catalunya
        </li>
      </ul>
    </div>

    <!-- Колонка 4: Юридический блок -->
    <div class="md:col-span-2 space-y-4 text-left">
      <h4 class="text-xs font-black uppercase text-gray-400 tracking-widest border-b border-gray-800 pb-2">Protecció Legal</h4>
      <ul class="space-y-2.5 text-xs font-bold">
        <li>
          <a href="/denuncies" class="text-amber-400 hover:text-amber-300 transition-colors inline-flex items-center gap-1 font-black uppercase text-[11px] tracking-wider animate-pulse">
            ⚠️ Bústia d'Alertes
          </a>
        </li>
        <li><a href="/legal#avis" class="text-gray-300 hover:text-white transition-colors cursor-pointer">Avís Legal</a></li>
        <li><a href="/legal#privacitat" class="text-gray-300 hover:text-white transition-colors cursor-pointer">Privacitat</a></li>
        <li><a href="/legal#cookies" class="text-gray-300 hover:text-white transition-colors cursor-pointer">Cookies</a></li>
      </ul>
    </div>

  </div>

  <!-- Тонкая линия и копирайт (Яркий текст) -->
  <div class="max-w-7xl mx-auto px-4 md:px-8 mt-12 pt-6 border-t border-gray-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-semibold text-gray-400">
    <p class="text-center sm:text-left leading-relaxed max-w-xs sm:max-w-none">
      &copy; 2026 Associació de Docents Ocupacionals de Catalunya. <span class="block sm:inline mt-0.5 sm:mt-0">Tots els drets reservats.</span>
    </p>
    <div class="flex gap-2 items-center text-[10px] font-black uppercase tracking-wider text-gray-400">
      <span>Garantia de Confidencialitat</span>
      <span>•</span>
      <span>Inspecció de Treball</span>
    </div>
  </div>
</footer>

    <!-- Вставлять сюда, в самый низ Layout.astro -->
<div id="admin-modal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-md flex items-center justify-center p-3 md:p-6 opacity-0 pointer-events-none transition-all duration-300 z-50">
    <div id="modal-card" class="w-full max-w-6xl bg-white border border-gray-200 rounded-sm p-5 md:p-8 shadow-2xl flex flex-col max-h-[90vh] text-brand-dark transform scale-95 transition-all duration-300 relative">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-brand-green"></div>
        <div class="flex items-center justify-between border-b border-gray-200 pb-4 shrink-0 mt-2">
            <div class="flex items-center gap-3">
                <span class="text-2xl">📊</span>
                <div class="text-left">
                    <h3 class="text-xl font-black text-brand-dark uppercase tracking-tight">Panell de Control de Gestió</h3>
                    <p class="text-xs text-gray-500 font-medium">Administració central de registres i auditories de la FP</p>
                </div>
            </div>
            <button id="close-modal-btn" class="w-8 h-8 flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xs cursor-pointer text-xl font-bold border-none transition-colors">&times;</button>
        </div>
        
        <div class="overflow-y-auto flex-1 space-y-6 py-4">
            <div id="admin-login-block" class="max-w-sm mx-auto text-center py-12 space-y-4">
                <p class="text-sm text-gray-600 font-semibold uppercase tracking-wider">Accés Restringit Administrador</p>
                <div class="flex flex-col gap-3 justify-center">
                    <input type="password" id="admin-password-input" class="w-full bg-gray-50 border-2 border-gray-200 p-3 rounded-xs font-semibold text-sm outline-none text-brand-dark focus:border-brand-green transition-colors" placeholder="Introduïu la contrasenya...">
                    <button id="submit-password-btn" class="bg-brand-green hover:bg-brand-hover font-black text-xs uppercase tracking-widest text-white px-5 py-4 rounded-xs cursor-pointer transition-all shadow-xs">Entrar al Sistema &rarr;</button>
                </div>
                <p id="login-error-msg" class="text-xs text-rose-600 hidden font-bold uppercase tracking-wider">⚠️ Contrasenya incorrecta.</p>
            </div>

            <div id="admin-content-block" class="hidden space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-3 flex-wrap gap-2 text-center select-none pt-2">
                    <div class="bg-gray-50 border border-gray-200 p-4 rounded-xs shadow-xs">
                        <span class="text-[10px] font-black uppercase tracking-wider text-gray-400 block mb-1">Total Registres</span>
                        <span id="metric-total" class="text-3xl font-black text-brand-dark">0</span>
                    </div>
                    <div class="bg-emerald-50/50 border border-emerald-100 p-4 rounded-xs shadow-xs">
                        <span class="text-[10px] font-black uppercase tracking-wider text-brand-green block mb-1">Socis Actius</span>
                        <span id="metric-socios" class="text-3xl font-black text-brand-green">0</span>
                    </div>
                    <div class="bg-blue-50/50 border border-blue-100 p-4 rounded-xs shadow-xs">
                        <span class="text-[10px] font-black uppercase tracking-wider text-[#007cc2] block mb-1">Amics PADA</span>
                        <span id="metric-padas" class="text-3xl font-black text-[#007cc2]">0</span>
                    </div>
                </div>

                <div class="flex flex-col lg:flex-row justify-between items-center gap-4 bg-gray-50 p-4 rounded-xs border border-gray-200">
                    <div class="flex flex-wrap gap-2 items-center w-full lg:w-auto">
                        <span class="text-xs font-black uppercase text-gray-500 tracking-wider mr-2">Filtrar per implicació:</span>
                        <button class="filter-role-btn px-4 py-2 text-xs font-extrabold rounded-xs border-2 border-brand-green bg-brand-green text-white cursor-pointer transition-all" data-role="all">TOTS ELS PERFILS</button>
                        <button class="filter-role-btn px-4 py-2 text-xs font-extrabold rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="socio">SOCI/A</button>
                        <button class="filter-role-btn px-4 py-2 text-xs font-extrabold rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="pada">PADA</button>
                        <!-- Кнопка подписки на новости теперь логично перенесена сюда наверх -->
                        <button class="filter-role-btn px-4 py-2 text-xs font-extrabold rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all" data-role="butlleti">✨ BUTLLETÍ</button>
                    </div>

                    <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full lg:w-auto justify-end">
                        <span class="text-xs font-black uppercase text-gray-500 tracking-wider">Ordena per:</span>
                        <select id="sort-leads-select" class="bg-white border-2 border-gray-200 p-2 rounded-xs text-xs font-bold text-gray-700 outline-none focus:border-brand-green cursor-pointer">
                            <option value="date-desc" selected>Data: Més recents primero</option>
                            <option value="date-asc">Data: Més antics primero</option>
                            <option value="name-asc">Nom: Alfabètic (A-Z)</option>
                            <option value="provincia-asc">Província (A-Z)</option>
                        </select>
                        <button id="export-csv-btn" class="bg-brand-dark text-white px-4 py-2.5 rounded-xs text-xs font-black uppercase tracking-wider hover:bg-black transition-colors cursor-pointer shadow-xs flex items-center gap-1.5">
                            📥 Exportar CSV
                        </button>
                    </div>
                </div>

                <!-- 🔄 ПЕРЕКЛЮЧАТЕЛЬ ВКЛАДОК В АДМИНКЕ (Теперь без кнопки Leads) -->
                <div class="flex flex-col md:flex-row items-stretch md:items-center gap-2 w-full p-4 border-b border-gray-100 pb-4 mb-6">
                    <button id="tab-btn-complaints" class="px-5 py-2 text-xs font-black rounded-xs border-2 border-brand-green bg-brand-green text-white cursor-pointer transition-all uppercase tracking-wider shadow-xs">
                       ⚠️ Denúncies
                    </button>
                    <button id="tab-btn-support" class="px-5 py-2 text-xs font-black rounded-xs border-2 border-gray-200 bg-white text-gray-600 hover:border-gray-300 cursor-pointer transition-all uppercase tracking-wider shadow-xs">
                       🆘 Suport
                    </button>
                    <a href="/admin" target="_blank" class="px-4 py-2 border border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100 font-black text-xs uppercase tracking-wider rounded-xs transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-sm md:ml-auto">
                       ✍️ Gestionar Contingut (CMS)
                    </a>
                </div>

                <div class="hidden md:block overflow-x-auto border border-gray-200 rounded-xs">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-200 text-xs font-black uppercase text-gray-500 tracking-wider">
                                <th class="p-4">Data</th>
                                <th class="p-4">Nom i Província</th>
                                <th class="p-4">Email</th>
                                <th class="p-4">Telèfon</th>
                                <th class="p-4">Rol Actiu</th>
                                <th class="p-4 text-center">Expedient</th>
                            </tr>
                        </thead>
                        <tbody id="leads-table-body" class="divide-y divide-gray-200 bg-white"></tbody>
                    </table>
                </div>
                <div id="leads-mobile-list" class="block md:hidden space-y-4"></div>
            </div>
        </div>
    </div>
</div>

<template id="table-row-template">
    <tr class="hover:bg-gray-50/80 transition-colors">
        <td class="p-4 text-gray-500 font-medium td-date"></td>
        <td class="p-4 font-bold text-brand-dark td-name"></td>
        <td class="p-4 text-gray-600 font-medium td-email"></td>
        <td class="p-4 text-gray-600 font-mono td-phone"></td>
        <td class="p-4"><span class="td-badge px-2 py-1 text-[10px] font-black rounded-xs uppercase tracking-wider"></span></td>
        <td class="p-4 text-center">
            <button class="view-answers-btn px-4 py-2 text-xs font-black bg-brand-green hover:bg-brand-hover text-white rounded-xs transition-all cursor-pointer uppercase tracking-wider shadow-xs">👀 Ver</button>
        </td>
    </tr>
</template>

<!-- Шаблон строки жалобы для ПК -->
<template id="complaint-row-template">
    <tr class="border-b border-gray-100 hover:bg-gray-50/50 transition-colors text-left text-xs font-semibold text-brand-dark">
        <td class="p-4 font-mono text-gray-400 comp-date"></td>
        <td class="p-4 font-bold uppercase tracking-tight comp-centre"></td>
        <td class="p-4 comp-type text-gray-600"></td>
        <td class="p-4 font-medium comp-contact"></td>
        <td class="p-4 text-right">
            <button class="view-complaint-btn bg-brand-dark hover:bg-black text-white px-3 py-1.5 rounded-xs font-black uppercase text-[10px] tracking-wider transition-colors cursor-pointer shadow-xs">
                👀 Leer
            </button>
        </td>
    </tr>
</template>

<!-- Шаблон карточки жалобы для мобильных -->
<template id="complaint-card-template">
    <div class="bg-white border border-gray-200 p-4 rounded-xs shadow-xs relative overflow-hidden space-y-3 text-left">
        <div class="absolute top-0 left-0 bottom-0 w-1 bg-amber-500"></div>
        <div class="flex justify-between items-center text-[10px] font-bold text-gray-400 uppercase tracking-wider">
            <span class="comp-card-date"></span>
            <span class="px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-100 rounded-xs">DENÚNCIA</span>
        </div>
        <div class="space-y-1">
            <h4 class="text-sm font-black text-brand-dark uppercase tracking-tight comp-card-centre"></h4>
            <p class="text-xs text-gray-500 font-semibold comp-card-type"></p>
        </div>
        <div class="pt-2 border-t border-gray-100 flex justify-between items-center text-xs">
            <p class="text-gray-400 font-medium">Contacte: <span class="text-brand-dark font-bold comp-card-contact"></span></p>
            <button class="view-complaint-btn text-[10px] font-black uppercase tracking-widest text-brand-dark hover:text-brand-green transition-colors">
                Llegir &rarr;
            </button>
        </div>
    </div>
</template>

<template id="mobile-card-template">
    <div class="bg-white p-5 rounded-xs border border-gray-200 shadow-xs space-y-3 text-left relative overflow-hidden">
        <div class="absolute top-0 left-0 bottom-0 w-1 bg-brand-green card-side-line"></div>
        <div class="flex justify-between items-center border-b border-gray-100 pb-2">
            <span class="card-date text-xs text-gray-400 font-semibold"></span>
            <span class="card-badge px-2 py-0.5 text-[9px] font-black rounded-xs uppercase tracking-wider"></span>
        </div>
        <p class="card-name font-black text-brand-dark text-base"></p>
        <div class="text-xs space-y-1 text-gray-600 font-medium">
            <p>Email: <span class="card-email text-brand-dark"></span></p>
            <p>Tel: <span class="card-phone text-brand-dark font-mono"></span></p>
        </div>
        <button class="view-answers-btn w-full mt-2 px-4 py-3 text-xs font-black bg-brand-green hover:bg-brand-hover text-white rounded-xs cursor-pointer uppercase tracking-widest shadow-xs">👀 Veure respostes</button>
    </div>
</template>

    <!-- 👁️ МОДАЛЬНОЕ ОКНО ПРОСМОТРА ОТВЕТОВ КВИЗА (Премиальный светлый стиль) -->
    <div id="answers-modal" class="fixed inset-0 bg-gray-900/40 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 z-50">
        <div id="answers-modal-card" class="w-full max-w-2xl bg-white border border-gray-200 rounded-sm p-6 md:p-8 shadow-2xl transform scale-95 transition-all duration-300 space-y-6 text-left text-brand-dark">
            
            <!-- Шапка документа ответов -->
            <div class="flex items-center justify-between border-b-2 border-gray-800 pb-3">
                <div>
                    <h4 class="font-sans font-black text-lg uppercase tracking-tight text-gray-900">Historial de Diagnòstic Laboral</h4>
                    <p id="ans-modal-lead-info" class="text-xs font-bold text-brand-green uppercase tracking-wider mt-0.5"></p>
                </div>
                <button id="close-answers-btn" class="font-bold text-gray-400 hover:text-brand-dark cursor-pointer text-2xl border-none bg-transparent">&times;</button>
            </div>
            
            <!-- Контейнер для вывода вопросов и ответов (Крупный читаемый шрифт) -->
            <div id="ans-modal-container" class="space-y-4 max-h-[50vh] overflow-y-auto py-2 text-base font-medium text-gray-700 divide-y divide-gray-100">
                <!-- Сюда JS вставит структурированные вопросы и ответы -->
            </div>
            
            <!-- Кнопка закрытия -->
            <div class="pt-2 border-t border-gray-100">
                <button id="close-answers-bottom-btn" class="w-full bg-gray-100 hover:bg-gray-200 text-brand-dark font-black text-xs uppercase tracking-widest py-4 rounded-xs transition-colors cursor-pointer border border-gray-200 shadow-xs">
                    Tancar expedient
                </button>
            </div>
        </div>
    </div>

        <!-- 📱 Шаг 1: Добавили 'overflow-y-auto' внешнему фону модалки -->
    <div id="cta-modal" class="fixed inset-0 bg-gray-900/40 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 z-50 overflow-y-auto">
        
        <!-- 📱 Шаг 2: Добавили 'max-h-[90vh]' и 'overflow-y-auto' самой белой карточке -->
        <div id="cta-modal-card" class="w-full max-w-4xl max-h-[90vh] overflow-y-auto bg-white border border-gray-200 rounded-sm p-6 shadow-2xl transform scale-95 transition-all duration-300 space-y-4 text-left text-brand-dark">
            
            <!-- Шапка окна (БЕЗ ИЗМЕНЕНИЙ) -->
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                <h4 id="cta-modal-title" class="text-lg font-black text-brand-dark uppercase tracking-tight">
                    <!-- Сюда JS вставит заголовок -->
                </h4>
                <button id="close-cta-modal-btn" class="text-gray-400 hover:text-brand-dark cursor-pointer text-xl font-bold border-none bg-transparent">&times;</button>
            </div>
            
            <!-- Текст сообщения (БЕЗ ИЗМЕНЕНИЙ) -->
            <div id="cta-modal-text" class="text-sm text-gray-600 leading-relaxed font-medium space-y-2">
                <!-- Сюда JS вставит официальный текст на каталонском -->
            </div>
            
            <!-- Кнопка закрытия внизу (БЕЗ ИЗМЕНЕНИЙ) -->
            <div class="pt-2">
                <button id="close-cta-modal-bottom-btn" class="w-full bg-gray-100 hover:bg-gray-200 text-brand-dark font-black text-xs uppercase tracking-widest py-3.5 rounded-xs transition-colors cursor-pointer border border-gray-200 shadow-xs">
                    Tancar finestra
                </button>
            </div>
        </div>
    </div>

 
  <script src="../js/menu.js"></script>
  <script src="../js/info.js"></script>
</body>
